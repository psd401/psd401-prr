# Long-running Django/Celery configuration only. The deploy Compose manifest
# injects scoped database and object-store credentials. Never put Postgres
# owner, MinIO root, or bootstrap-superuser credentials in this file.
#
# What is left here is what the application has to read BEFORE it can read a
# stored setting -- the database, the cache, the object store, the keys, the
# hostnames. Nothing else.
#
# Everything a district decides is managed in the application (Configuration >
# Settings, Application Admin only, written reason required, full history):
# the on/off switches, every limit, rate, timeout, domain and address list,
# the advisory model, the Google service identities the application acts as,
# staff sign-in including the OAuth client and its write-only secret, the
# malware scanner, the Alta camera API and its write-only token, the portal
# address, the supervisor/officer/facilities addresses, and district closure
# days.
# Setting one of them here does nothing once the deployment has imported its
# values. See docs/aws-deploy.md.

RUN_MIGRATIONS=false
AUTO_SEED=false
# DJANGO_SECRET_KEY and PRR_SETTINGS_ENCRYPTION_KEY are not set here. On the
# AWS host every Django process reads them from the AWS Secrets Manager secret
# psd401-prr/prod/runtime (docker-compose.aws.yml sets PRR_RUNTIME_SECRET_ID)
# and refuses to start if either also appears in this file. Production's
# settings key is blank, so stored settings are encrypted under a key derived
# from DJANGO_SECRET_KEY: never rotate or regenerate it without re-encrypting
# them first. See docs/aws-deploy.md, "Runtime secret".
DJANGO_ALLOWED_HOSTS=prr.psd401.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://prr.psd401.net
DJANGO_TRUST_X_FORWARDED_PROTO=true
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=prr-records
OBJECT_STORE_REGION=
PRR_ENVIRONMENT=production
# The container's own keyless identity. It is a non-secret, bare
# external-account config, and it is what the application impersonates the
# Gmail, Vault, and group-reader service accounts FROM. Which accounts those
# are is configured in the application, not here. Never put a Google
# private-key path in this file.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/prr-google-runtime-credential.json
