{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::prr-records"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::prr-records"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "quarantine/intake/*",
            "quarantine/correspondence/raw/*",
            "quarantine/correspondence/attachments/*",
            "quarantine/vault-messages/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::prr-records/quarantine/intake/*",
        "arn:aws:s3:::prr-records/quarantine/correspondence/raw/*",
        "arn:aws:s3:::prr-records/quarantine/correspondence/attachments/*",
        "arn:aws:s3:::prr-records/quarantine/vault-messages/*",
        "arn:aws:s3:::prr-records/intake/*",
        "arn:aws:s3:::prr-records/correspondence/attachments/*",
        "arn:aws:s3:::prr-records/records/*",
        "arn:aws:s3:::prr-records/productions/*",
        "arn:aws:s3:::prr-records/exemption-logs/*",
        "arn:aws:s3:::prr-records/vault-exports/*",
        "arn:aws:s3:::prr-records/vault-messages/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::prr-records/quarantine/intake/*",
        "arn:aws:s3:::prr-records/quarantine/correspondence/raw/*",
        "arn:aws:s3:::prr-records/quarantine/correspondence/attachments/*",
        "arn:aws:s3:::prr-records/quarantine/vault-messages/*"
      ]
    }
  ]
}
