{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.app)",
      "Edit(**/.env)",
      "Edit(**/.env.app)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cdk-synth.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/terraform-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
