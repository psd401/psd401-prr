# What is left here is what the application has to read before it can read a
# stored setting, plus the operator-owned addresses and integration endpoints
# no phase has moved yet. Everything a district decides is managed in the
# application (Configuration > Settings, Application Admin only, written
# reason required, full history): the on/off switches, every limit, rate,
# timeout, domain and address list, the advisory model, the Google service
# identities the application acts as, and staff sign-in including the OAuth
# client and its write-only secret. Setting one of them here does nothing
# once the deployment has imported its values. See docs/aws-deploy.md.
#
# A local run starts in local sign-in mode with the Django admin route open,
# because DEBUG is true. Both are settings; change them in the application.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# The deployment Compose manifest pins this to production for every Django
# process. Keep development here for direct local runs.
PRR_DEPLOYMENT_MODE=development
DATABASE_URL=postgres://prr:prr-dev-only@db:5432/prr
POSTGRES_PASSWORD=prr-dev-only
POSTGRES_APP_USER=prr_app
POSTGRES_APP_PASSWORD=replace-with-a-distinct-app-database-password
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=prr-records
OBJECT_STORE_ACCESS_KEY=prr
OBJECT_STORE_SECRET_KEY=prr-dev-only
OBJECT_STORE_REGION=
# Optional. See .env.app.example; blank derives the key from
# DJANGO_SECRET_KEY, which is fine for a throwaway local database.
PRR_SETTINGS_ENCRYPTION_KEY=
MINIO_ROOT_USER=prr
MINIO_ROOT_PASSWORD=prr-dev-only
MINIO_APP_USER=prr-app
MINIO_APP_PASSWORD=replace-with-a-distinct-bucket-scoped-password
# Legacy variables the Vault key file and administrator account used to
# default from. They are read once, by `manage.py import_environment_settings`,
# to carry an existing deployment's values into the settings store; after
# that the application owns both and these do nothing.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/vault-sa.json
VAULT_ADMIN_USER=vault-admin@example.org
# The container's own keyless identity, which the Gmail, Vault, and
# group-reader service accounts are impersonated FROM. Blank locally: a
# developer configures a key file in the application instead, and a deployed
# instance refuses a key file outright.
GOOGLE_APPLICATION_CREDENTIALS=
# The malware scanner, Alta, the portal address, the supervisor/officer/
# facilities addresses, and district closure days are Settings-page values.
# A host-run developer may still export CLAMAV_HOST (docs/development.md): a
# key with no stored row resolves through the environment.
PRR_ENVIRONMENT=development
# Deployment security/integration settings. HTTPS redirect, secure cookies,
# and HSTS default automatically when DJANGO_DEBUG=false.
# Production: DJANGO_ALLOWED_HOSTS=prr.psd401.net and
# DJANGO_CSRF_TRUSTED_ORIGINS=https://prr.psd401.net
# Local development stays in local identity mode and does not reuse a deployed
# hostname, callback, credential, or production-derived data.
# Set true only behind a trusted proxy that overwrites X-Forwarded-Proto:
# DJANGO_TRUST_X_FORWARDED_PROTO=true
